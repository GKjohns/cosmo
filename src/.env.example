# Cosmo runs in DEMO MODE by default — every key in this file is optional and
# `npm run dev` boots clean with NOTHING set: auth is a fixture user, Supabase
# calls short-circuit to canned data, and Stripe / Resend / Inngest sit behind
# the same "configured?" gate. `cp .env.example .env` leaves you in demo mode.
#
# Values are intentionally EMPTY (a placeholder would silently flip a service
# "live" against nothing). Set all three Supabase vars to leave demo mode; the
# boot banner says which world you're in.

# --- Supabase (auth + DB) ---------------------------------------------------
# All three or none. Project Settings → API. `SUPABASE_KEY` is the publishable
# (`sb_publishable_…`) key — safe in the browser. `SUPABASE_SECRET_KEY`
# (`sb_secret_…`) is server-only, bypasses RLS: never ship it to the client.
# Legacy names `SUPABASE_ANON_KEY` / `SUPABASE_SERVICE_ROLE_KEY` still work but
# print a rename warning at boot.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=

# --- Vercel AI Gateway ------------------------------------------------------
# The only AI path cosmo ships (chat, completion, Inngest workers). Without it
# the chat surface still loads and replies with a canned "add
# AI_GATEWAY_API_KEY" message; the editor's inline AI returns 503. Vercel →
# AI Gateway → API keys. Server-only.
AI_GATEWAY_API_KEY=

# --- Inngest (job queue) ---------------------------------------------------
# `npm run dev` boots the local Inngest CLI without these. Set both in Vercel
# (Inngest → app → keys) for the hosted service. Server-only.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Resend (transactional email) ------------------------------------------
# Server-only. Sends are dev-gated: outside production nothing goes out unless
# RESEND_ALLOW_SEND=1. `RESEND_FROM` like "Cosmo <hello@yourdomain.com>".
RESEND_API_KEY=
RESEND_FROM=
RESEND_ALERT_FROM=
RESEND_ALERT_TO=
RESEND_ALLOW_SEND=

# --- Stripe (billing) ------------------------------------------------------
# Stub-by-default — leave blank to render the billing chrome without keys.
# Publishable key is public; the rest are server-only (webhook secret from
# `stripe listen` locally, the Dashboard endpoint in prod).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# --- Dev tools -------------------------------------------------------------
# Domain for `test+<ts>@…` addresses minted by /internal/dev-tools. Defaults
# to `cosmo.test`, a non-routable TLD — nothing can bounce off a real mailbox.
TEST_USER_EMAIL_DOMAIN=
